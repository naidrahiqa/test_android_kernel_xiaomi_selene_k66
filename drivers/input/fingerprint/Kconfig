#
# Fingerprint
#
menu "Fingerprint support"
	depends on INPUT

config MTK_FINGERPRINT_SUPPORT
	bool "Mediatek Fingerprint"
	default n
	help
	  Fingerprint mtk driver enable/disable in the kernel.
	  Say Y here if you want to use MediaTek fingerprint driver.

if MTK_FINGERPRINT_SUPPORT

config FPC_FINGERPRINT
	tristate "FPC Fingerprint"
	depends on SPI && MICROTRUST_TEE_SUPPORT
	help
	  FPC fingerprint FPC's 102x/104x device.

config GOODIX_FINGERPRINT
	tristate "Goodix Fingerprint"
	depends on SPI && MICROTRUST_TEE_SUPPORT
	help
	  Goodix Fingerprint chip GF316M/GF3208/
	  GF3118M/GF518M/GF5118M/GF516M/GF816M/
	  GF3206/GF3266/GF3288/GF5206/GF5216/GF5208 TEE driver.

config GOODIX_SENSOR_TYPE
	string "SENSOR_TYPE"
	depends on GOODIX_FINGERPRINT
	default "GF5216"
	help
	  Must input sensor type, or default is
	  GF316M GF3208 GF3118M GF518M GF5118M
	  GF516M GF816M GF3206 GF3266 GF3288
	  GF5206 GF5216 GF5208.

endif
endmenu
