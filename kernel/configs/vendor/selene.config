CONFIG_HQ_SYSFS_SUPPORT=m
CONFIG_TARGET_PRODUCT_SELENE=y


CONFIG_MTK_LCM_PHYSICAL_ROTATION="0"
CONFIG_LCM_HEIGHT="2400"
CONFIG_LCM_WIDTH="1080"

CONFIG_CHARGER_BQ2589X=m
CONFIG_CHARGER_SMB1351=m

CONFIG_DRM_PANEL_K19A_36_02_0A_DSC_VDO=m
CONFIG_DRM_PANEL_K19A_43_02_0B_DSC_VDO=m
CONFIG_DRM_PANEL_K19A_36_03_0C_DSC_VDO=m

CONFIG_MTK_FLASHLIGHT_LED191=m

# CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI is not set
CONFIG_TOUCHSCREEN_NT36672C_SPI=m
CONFIG_TOUCHSCREEN_FOCALTECH_SPI=m

CONFIG_SND_SOC_AW87559=m
CONFIG_SND_SOC_FS16XX=m
CONFIG_TCPC_FUSB302=m
CONFIG_TCPC_FUSB303=m

CONFIG_CUSTOM_KERNEL_IMGSENSOR="ov50c40_ofilm_main_mipi_raw s5kjn1_ofilm_main_mipi_raw ov50c40_qtech_main_mipi_raw ov8856_ofilm_front_mipi_raw ov8856_aac_front_mipi_raw gc02m1b_sunny_mipi_raw ov02b1b_ofilm_mipi_raw gc02m1_macro_aac_mipi_raw gc02m1_macro_sy_mipi_raw imx355_sunny_ultra_mipi_raw imx355_aac_ultra_mipi_raw"

CONFIG_MTK_LENS=m
CONFIG_MTK_LENS_GT9764AF_SUPPORT=m
CONFIG_MTK_LENS_CN3927AF_J19_SUPPORT=m

CONFIG_MTK_FINGERPRINT_SUPPORT=y
CONFIG_GOODIX_FINGERPRINT=m
CONFIG_FPC_FINGERPRINT=m

CONFIG_NFC_CHIP_SUPPORT=y
CONFIG_NFC_PN553_19A_DEVICES=m
CONFIG_MTK_SAR_HUB=y

# Early-boot bringup overrides over gki_defconfig (MT6768 / ARMv8.2-A)
CONFIG_CMDLINE="earlycon=uart8250,mmio32,0x11002000 console=tty0"
CONFIG_CMDLINE_EXTEND=y
# CONFIG_CMDLINE_FROM_BOOTLOADER is not set
# CONFIG_CMDLINE_FORCE is not set
# CONFIG_BOOT_CONFIG is not set
# CONFIG_KASAN is not set
# CONFIG_KASAN_HW_TAGS is not set
# CONFIG_ARM64_MTE is not set
# CONFIG_UBSAN is not set
# CONFIG_UBSAN_TRAP is not set
# CONFIG_UBSAN_SANITIZE_ALL is not set
CONFIG_CFI_PERMISSIVE=y
# CONFIG_KVM is not set
# CONFIG_EFI is not set
# CONFIG_EFI_STUB is not set
# CONFIG_ARM64_PTR_AUTH_KERNEL is not set
# CONFIG_SHADOW_CALL_STACK is not set
# CONFIG_DYNAMIC_SCS is not set
# CONFIG_UNWIND_PATCH_PAC_INTO_SCS is not set
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_NR_CPUS=8
CONFIG_PANIC_TIMEOUT=5
# CONFIG_PANIC_ON_OOPS is not set
# CONFIG_TCPC_RT1711H is not set
# CONFIG_MTK_PKVM_TMEM is not set
# CONFIG_MTK_PKVM_MTK_SMC_HANDLER is not set
# CONFIG_MTK_PKVM_MKP is not set
# CONFIG_MTK_PKVM_SMMU is not set

