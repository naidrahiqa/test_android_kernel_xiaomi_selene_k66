CONFIG_MATCH_XIAOMI=m


CONFIG_MICROTRUST_TEE_VERSION="400"

CONFIG_BACKLIGHT_LM3697=m
CONFIG_BACKLIGHT_KTD3136=m

# No Extra MTK Sched
# CONFIG_MTK_TASK_TURBO is not set
# CONFIG_MTK_FPSGO_V3 is not set
# CONFIG_MTK_CROSS_SCHEDULER is not set

# For Debugging
CONFIG_MTK_EARLY_KLOG_PUBLISH=y
CONFIG_MTK_EARLY_KLOG_SRAM_ADDR=0x10F200
CONFIG_LOG_BUF_SHIFT=21